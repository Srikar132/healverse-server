# Copy to .env and fill in. .env is git-ignored; this example file is committed.

# Base64-encoded HS256 signing key, at least 32 bytes. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=

# PostgreSQL (Neon). Full JDBC URL, e.g. jdbc:postgresql://<host>/<db>?sslmode=require
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Optional: real OpenAI key. If unset, the app falls back to the dummy default in application.properties.
# OPENAI_API_KEY=
