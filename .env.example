# Copy to .env and fill in. .env is git-ignored; this example file is committed.

# Base64-encoded HS256 signing key, at least 32 bytes. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=

# PostgreSQL (Neon). Full JDBC URL, e.g. jdbc:postgresql://<host>/<db>?sslmode=require
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Groq API key (https://console.groq.com/keys). Required: the app uses Groq for text and image AI.
GROQ_API_KEY=

# Optional model overrides (defaults shown). Vision is a Groq preview model.
# AI_TEXT_MODEL=openai/gpt-oss-120b
# AI_VISION_MODEL=qwen/qwen3.8-27b
